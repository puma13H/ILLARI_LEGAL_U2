# Angular artifacts are built and tested by BUILD-S12.ps1 before creating this runtime.
FROM nginx:1.27-alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY frontend/dist/casos-legales-frontend/browser /usr/share/nginx/html
COPY infra/docker/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/40-runtime-config.sh

