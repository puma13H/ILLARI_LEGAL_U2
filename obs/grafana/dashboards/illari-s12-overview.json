      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job) (increase(http_server_requests_seconds_count{status=~\"4..\"}[5m]))",
          "legendFormat": "{{job}}"
